<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Tráfego HTTP restrito e controlado via Network Security Config (QA-016) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Servidores de streaming IPTV públicos padrão e proxies locais -->
        <domain includeSubdomains="true">ebc.com.br</domain>
        <domain includeSubdomains="true">fabricahost.com.br</domain>
        <domain includeSubdomains="true">rakuten.tv</domain>
        <domain includeSubdomains="true">wurl.tv</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
